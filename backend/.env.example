# ---- MODE A: fully local (Docker LiveKit, recordings on disk). Default if you change nothing. ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecret

# ---- MODE B: LiveKit Cloud (works from any network) + recordings in Azure Blob ----
# Comment out the three lines above and fill these in:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_CONTAINER=recordings

PORT=4000

# Optional: send sign-up verification codes by email (Gmail: create an App Password at myaccount.google.com/apppasswords)
# Without these, the code is printed in the backend window instead.
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# APP_NAME=Akashwani

# Optional: your free static ngrok domain (dashboard.ngrok.com -> Domains -> New domain) so the link never changes.
# NGROK_DOMAIN=akashwani.ngrok-free.app
